{
  "name": "little-batch-works",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Little Batch Works — a cozy 3D voxel conveyor-routing tycoon (web build).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:windows": "npm run build && electron-builder --win nsis portable --x64",
    "build:android": "node scripts/build-android.mjs",
    "cap:sync": "npm run build && cap sync android",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:levels": "node scripts/check-levels.mjs",
    "check": "npm test && npm run check:levels && npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.littlebatchworks.game",
    "productName": "Little Batch Works",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
